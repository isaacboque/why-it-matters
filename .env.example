# Optional: model-written captions in any language (see docs/LLM.md).
# Without this file everything runs on the offline templates (EN / ES / CA), no key needed.
#
# Copy to .env (gitignored), fill in ONE option, then load it into your shell:
#   set -a && source .env && set +a
# The app reads environment variables only; it does not parse .env by itself.

WIM_GENERATOR=llm

# Option A: Microsoft Foundry / Azure OpenAI (all three are needed)
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="<your deployment name, e.g. gpt-4.1-mini>"
AZURE_OPENAI_API_KEY="<key>"

# Option B: GitHub Models, used only when the Azure variables above are not all set
# GITHUB_TOKEN="<token with models access>"

# Cost guard: model requests per match (default 60)
# WIM_LLM_MAX_CALLS=60
